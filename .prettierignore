# Capability artifacts are written by the artifact serializer in a canonical form.
# Reformatting them here would break the guarantee that a saved artifact is byte
# identical to what the serializer produces.
capabilities/**/*.json

# Run evidence is written by the recorder, and a manifest is a record of what a run did.
# Reformatting one would make the committed file disagree with what the recorder produces,
# which is the same reason capability artifacts are left alone.
evidence/**/*.json
evidence/**/*.jsonl
