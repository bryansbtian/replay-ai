# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# The model. Discovery uses one; replay never does.
# ---------------------------------------------------------------------------

# Which implementation of the model boundary discovery is given.
# ollama    a model running on this machine. No account, no key, no cost.
# anthropic the hosted API. Requires ANTHROPIC_API_KEY.
LLM_PROVIDER=ollama

# Where the local runtime listens, and which model answers. Use the loopback
# address rather than "localhost": on Windows that resolves to IPv6 first and
# reaches nothing when the daemon is listening on IPv4.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Used only when LLM_PROVIDER=anthropic. Every other command, and the whole test
# suite, runs without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# What bounds a discovery run. The model cannot see or raise either of them.
DISCOVERY_MAX_STEPS=15
DISCOVERY_TIMEOUT_MS=180000

# debug | info | warn | error
LOG_LEVEL=info

# Where run evidence is written. Relative paths resolve against the repo root.
EVIDENCE_DIR=evidence

# Where capability artifacts are read from and written to.
CAPABILITIES_DIR=capabilities

# Surface waiting budgets in milliseconds. Raise them for a slow legacy application.
SURFACE_NAVIGATION_TIMEOUT_MS=15000
SURFACE_LOCATOR_TIMEOUT_MS=5000
SURFACE_ACTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Safety policy. This is the authority: a capability artifact describes what it
# does and never grants itself permission to do it. Every setting below defaults
# to the cautious value, so an unset variable can only make this deployment
# refuse more, never less.
# ---------------------------------------------------------------------------

# Hosts this deployment may reach, comma separated. A hostname may pin a port
# ("localhost:3000"); without one it matches any port on that host. Empty means
# nothing is reachable. There are no wildcards, and "localhost" does not imply
# "127.0.0.1": list the forms you actually use.
POLICY_ALLOWED_HOSTS=localhost,127.0.0.1

# Permitted URL schemes. Default is https alone. "file" is what the local test
# fixture uses and a production deployment would not enable it.
POLICY_ALLOWED_SCHEMES=https,http

# Optional path prefixes, matched on segment boundaries, so "/members" covers
# "/members/42" and not "/membersecret". Empty means every path on an allowed
# host. A scheme with no host, such as file, requires this list.
POLICY_ALLOWED_ROUTES=

# Action types this deployment permits. Defaults to every step type the artifact
# schema defines. Narrow it to make a deployment read-only, for example:
# POLICY_ALLOWED_ACTIONS=navigate,extract,wait,checkpoint
POLICY_ALLOWED_ACTIONS=navigate,click,fill,extract,wait,checkpoint

# What to do with an action at each declared risk level.
# allow | requireConfirmation | block
POLICY_RISK_SAFE=allow
POLICY_RISK_RISKY=requireConfirmation
POLICY_RISK_IRREVERSIBLE=block
