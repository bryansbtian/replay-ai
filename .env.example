# Copy to .env and fill in. .env is git-ignored and must never be committed.

# The only shipped provider. Discovery uses it; replay never does.
LLM_PROVIDER=ollama
# Loopback, not localhost: Windows resolves localhost to IPv6 first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local model identifier. Replay never reads this.
OLLAMA_MODEL=gemma3:27b

# Ceiling on model decisions. The model cannot see or raise it.
DISCOVERY_MAX_STEPS=15
# Wall-clock ceiling for one discovery run, in milliseconds.
DISCOVERY_TIMEOUT_MS=180000

# How long an intervention waits for a person. Generous: it measures somebody walking over.
HUMAN_INTERVENTION_TIMEOUT_MS=900000
# Port for the local operator interface. Zero asks the operating system for a free one.
OPERATOR_PORT=0

# debug | info | warn | error
LOG_LEVEL=info
# Run records. Relative paths resolve against the repo root.
EVIDENCE_DIR=evidence
# Saved capability artifacts.
CAPABILITIES_DIR=capabilities

# Raise these for a slow legacy application.
SURFACE_NAVIGATION_TIMEOUT_MS=15000
SURFACE_LOCATOR_TIMEOUT_MS=5000
SURFACE_ACTION_TIMEOUT_MS=10000

# Comma-separated hosts this deployment may reach. Add a site the same way as any other.
POLICY_ALLOWED_HOSTS=localhost,127.0.0.1,seatping.biz,www.seatping.biz
# https is the default. http is for local fixtures; file is opt-in.
POLICY_ALLOWED_SCHEMES=https,http
# Path prefixes on segment boundaries. Empty means every path on an allowed host.
POLICY_ALLOWED_ROUTES=
# Narrow this to make a deployment read-only.
POLICY_ALLOWED_ACTIONS=navigate,click,fill,extract,wait,checkpoint
# allow | requireConfirmation | block
POLICY_RISK_SAFE=allow
POLICY_RISK_RISKY=requireConfirmation
POLICY_RISK_IRREVERSIBLE=block
